# ═══════════════════════════════════════════════════════════════════
# Plantilla de variables de entorno — copiar a .env y completar valores
# reales. .env está en .gitignore y nunca debe subirse al repositorio.
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════════════════
API_TITLE=Sistema de Vectorizacion Documental v2
API_VERSION=2.0.0
API_HOST=0.0.0.0
API_PORT=8100
DEBUG=False

# ═══════════════════════════════════════════════════════════════════
# Storage
# ═══════════════════════════════════════════════════════════════════
TEMP_DIR=./temp_docs
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".pptx", ".ppt", ".xlsx", ".jpg", ".jpeg", ".png", ".webp", ".mp4", ".mov", ".webm", ".mkv", ".mp3", ".wav", ".m4a", ".ogg"]

# ═══════════════════════════════════════════════════════════════════
# Qdrant
# ═══════════════════════════════════════════════════════════════════
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_HTTPS=False
DEFAULT_VECTOR_SIZE=1536
DEFAULT_DISTANCE=Cosine

# ═══════════════════════════════════════════════════════════════════
# API Externa (no usada actualmente por el codigo, requerida por settings.py)
# ═══════════════════════════════════════════════════════════════════
COLLECTIONS_API_URL=http://localhost:8100/api/collections

# ═══════════════════════════════════════════════════════════════════
# Embeddings
# ═══════════════════════════════════════════════════════════════════
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Azure Embeddings (solo si EMBEDDING_MODEL=text-embedding-3-small) ──
AZURE_EMBEDDING_KEY=
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-05-01-preview

# ═══════════════════════════════════════════════════════════════════
# Text Processing
# ═══════════════════════════════════════════════════════════════════
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ═══════════════════════════════════════════════════════════════════
# ASR (audio/video) y OCR (imagenes)
# ═══════════════════════════════════════════════════════════════════
ASR_MODEL_SIZE=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
OCR_LANGUAGES=es,en

# ═══════════════════════════════════════════════════════════════════
# Moodle
# ═══════════════════════════════════════════════════════════════════
MOODLE_URL=
MOODLE_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# LLM Generation & Vision (Pipeline RAG) — todas opcionales
# ═══════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
COHERE_API_KEY=
DEEPGRAM_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# RAG Pipeline Defaults (Strategy Pattern) — ver settings.py AVAILABLE_*
# ═══════════════════════════════════════════════════════════════════
ETL_DOCUMENT_STRATEGY=local
ETL_AUDIO_STRATEGY=faster_whisper_local
CONTEXTUAL_STRATEGY=none
SPARSE_EMBEDDING_STRATEGY=bm25
RERANK_STRATEGY=bge_local
RERANK_TOP_K=50
RERANK_TOP_N=5
RERANK_BOOST_MULTIPLIER=1.15
GENERATION_STRATEGY=gpt4o_mini

# ═══════════════════════════════════════════════════════════════════
# Postgres (configuracion del gestor, asistentes, RD)
# ═══════════════════════════════════════════════════════════════════
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# ═══════════════════════════════════════════════════════════════════
# Autenticacion del gestor (/gestor) — cambiar despues del primer login
# ═══════════════════════════════════════════════════════════════════
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET_KEY=

# ═══════════════════════════════════════════════════════════════════
# Asistentes publicos
# ═══════════════════════════════════════════════════════════════════
PUBLIC_BASE_URL=http://localhost:8100
